<script>
  // category pill filter
  const pills = document.querySelectorAll('.pill');
  const playSection = document.getElementById('play');
  const lumenSection = document.getElementById('lumen');
  const promoBlock = document.getElementById('promo');

  pills.forEach(p => {
    p.addEventListener('click', () => {
      pills.forEach(x => x.classList.remove('active'));
      p.classList.add('active');
      const f = p.dataset.filter;
      playSection.style.display = (f === 'all' || f === 'play') ? '' : 'none';
      lumenSection.style.display = (f === 'all' || f === 'lumen') ? '' : 'none';
      promoBlock.style.display = (f === 'all' || f === 'promo') ? '' : 'none';
      if(f !== 'all'){
        document.getElementById(f === 'promo' ? 'promo' : f).scrollIntoView({behavior:'smooth', block:'start'});
      }
    });
  });
</script>


---
import '../styles/greens.css';
import HeaderActions from '../components/HeaderActions';
import GreensHeaderSearch from '../components/GreensHeaderSearch';
import GreensFooter from '../components/GreensFooter';
import PulsarCategories from '../components/PulsarCategories';
import OrganicProductGrid from '../components/OrganicProductGrid';
import CombosSection from '../components/CombosSection';
import CartDrawer from '../components/CartDrawer';
import ProductModal from '../components/ProductModal';
import EditCanvas from '../components/EditCanvas';
import PulsarTexts from '../components/PulsarTexts';
import TermsGate from '../components/TermsGate.astro';

const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Organic — Le bio, livré chez vous</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<script is:inline>
  (function () {
    var t = 'light';
    try { t = localStorage.getItem('greens_theme') || 'light'; } catch (e) {}
    document.documentElement.dataset.theme = t;
  })();
</script>
</head>
<body>

<TermsGate />

<!-- PRELOADER -->
<div class="preloader-wrapper" id="ogPreloader">
  <div class="preloader"></div>
</div>

<!-- HEADER -->
<header class="og-header">
  <div class="container-lg">
    <div class="row align-items-center py-3 g-0">
      <div class="col-6 col-lg-2 d-flex gap-3 align-items-center">
        <button class="og-burger d-lg-none" id="ogBurger" aria-label="Menu">☰</button>
        <a href="/" class="d-flex align-items-center">
          <img src="/images/logo.svg" alt="Organic" style="height: 40px;">
          <span class="og-brand" data-edit-text="storeName" data-text-key="storeName">Organic</span>
        </a>
      </div>
      <div class="col-lg-5 d-none d-lg-block">
        <GreensHeaderSearch client:load />
      </div>
      <div class="col-lg-3 d-none d-lg-block">
        <ul class="nav justify-content-center og-nav">
          <li class="nav-item"><a class="nav-link" href="/#shop">Boutique</a></li>
          <li class="nav-item"><a class="nav-link" href="/#featured">Offres</a></li>
          <li class="nav-item"><a class="nav-link" href="/mentions-legales">Contact</a></li>
        </ul>
      </div>
      <div class="col-6 col-lg-2 d-flex gap-3 align-items-center justify-content-end">
        <button class="og-theme" id="ogThemeBtn" aria-label="Thème">🌙</button>
        <a href="/#lineup" class="og-heart d-none d-sm-block" aria-label="Favoris">♥</a>
        <HeaderActions client:load />
      </div>
    </div>
  </div>
  <nav class="og-mobile-nav d-lg-none" id="ogMobileNav">
    <a href="/#shop">Boutique</a>
    <a href="/#featured">Offres</a>
    <a href="/mentions-legales">Contact</a>
  </nav>
</header>

<!-- HERO -->
<section class="og-hero" style="background-image: url('/images/banner-1.jpg');">
  <div class="container-lg py-5">
    <div class="row">
      <div class="col-lg-7 pt-5 mt-5">
        <h1 class="display-1 hero-title" data-edit-text="tagline" data-text-key="tagline">
          <span class="text-primary">Organic</span> Foods at your <span class="fw-bold">Doorsteps</span>
        </h1>
        <p class="hero-sub mt-4" data-edit-text="tagline_sub" data-text-key="tagline_sub">Des produits frais et bio, livrés chez vous.</p>
        <div class="d-flex gap-3 flex-wrap mt-4">
          <a href="/#shop" class="btn btn-primary text-uppercase rounded-pill px-4 py-3">Start Shopping</a>
          <a href="/#lineup" class="btn btn-dark text-uppercase rounded-pill px-4 py-3">Join Now</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES STRIP -->
<section class="container-lg">
  <div class="row row-cols-1 row-cols-md-3 g-0 my-4 rounded-3 overflow-hidden shadow-sm">
    <div class="col bg-primary text-light p-4">
      <div class="og-feature">
        <span class="og-feature-icon">🌱</span>
        <div>
          <h5 data-edit-text="feature_1_title" data-text-key="feature_1_title">Fresh from farm</h5>
          <p data-edit-text="feature_1_desc" data-text-key="feature_1_desc">Des fruits et légumes frais, directement de la ferme.</p>
        </div>
      </div>
    </div>
    <div class="col bg-secondary text-light p-4">
      <div class="og-feature">
        <span class="og-feature-icon">🌿</span>
        <div>
          <h5 data-edit-text="feature_2_title" data-text-key="feature_2_title">100% Organic</h5>
          <p data-edit-text="feature_2_desc" data-text-key="feature_2_desc">Une sélection 100% bio et naturelle.</p>
        </div>
      </div>
    </div>
    <div class="col bg-danger text-light p-4">
      <div class="og-feature">
        <span class="og-feature-icon">🚚</span>
        <div>
          <h5 data-edit-text="feature_3_title" data-text-key="feature_3_title">Free delivery</h5>
          <p data-edit-text="feature_3_desc" data-text-key="feature_3_desc">Livraison rapide, offerte dès 5 000 DA.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section id="shop" class="container-lg py-5">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <span class="eyebrow" data-edit-text="eyebrow-categories" data-text-key="eyebrow-categories">Browse by category</span>
      <h2 class="section-title mt-1" data-edit-text="title-categories" data-text-key="title-categories">Category</h2>
    </div>
    <a href="/#lineup" class="btn btn-primary rounded-pill px-4">View All</a>
  </div>
  <PulsarCategories client:load />
</section>

<!-- PRODUCTS -->
<section id="lineup" class="container-lg pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <span class="eyebrow" data-edit-text="eyebrow-lineup" data-text-key="eyebrow-lineup">The lineup</span>
      <h2 class="section-title mt-1" data-edit-text="title-lineup" data-text-key="title-lineup">Best selling products</h2>
    </div>
    <a href="/#shop" class="btn btn-outline-secondary rounded-pill px-4">Shop All</a>
  </div>
  <OrganicProductGrid client:load />
</section>

<!-- COMBOS -->
<section id="combos" class="container-lg py-4">
  <CombosSection client:load />
</section>

<!-- BANNER BLOCKS -->
<section id="featured" class="container-lg py-4">
  <div class="banner-blocks">
    <div class="banner-block" style="background-image: url('/images/banner-ad-1.jpg'); background-size: cover; background-position: center; min-height: 250px;">
      <div class="banner-content">
        <h3>Items on SALE</h3>
        <p>Discounts up to 30%</p>
        <a href="/#lineup" class="btn btn-light btn-sm rounded-pill px-4">Shop Now</a>
      </div>
    </div>
    <div class="banner-block" style="background-image: url('/images/banner-ad-2.jpg'); background-size: cover; background-position: center; min-height: 250px;">
      <div class="banner-content">
        <h3>Combo offers</h3>
        <p>Discounts up to 50%</p>
        <a href="/#combos" class="btn btn-light btn-sm rounded-pill px-4">Découvrir</a>
      </div>
    </div>
    <div class="banner-block" style="background-image: url('/images/banner-ad-3.jpg'); background-size: cover; background-position: center; min-height: 250px;">
      <div class="banner-content">
        <h3>Discount Coupons</h3>
        <p>Discounts up to 40%</p>
        <a href="/#lineup" class="btn btn-light btn-sm rounded-pill px-4">Shop Now</a>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="og-footer py-5 mt-4">
  <div class="container-lg">
    <div class="row g-4">
      <div class="col-lg-3">
        <img src="/images/logo.svg" alt="Organic" style="height: 40px;" class="mb-3">
        <p class="text-muted small" data-edit-text="footer_desc" data-text-key="footer_desc">Des produits frais et locaux, livrés directement chez vous.</p>
      </div>
      <div class="col-md-2">
        <h5 class="widget-title" data-edit-text="footer_heading_1" data-text-key="footer_heading_1">Organic</h5>
        <ul class="list-unstyled">
          <li><a href="/#shop">À propos</a></li>
          <li><a href="/mentions-legales">Conditions</a></li>
          <li><a href="/#featured">Nos Journaux</a></li>
        </ul>
      </div>
      <div class="col-md-2">
        <h5 class="widget-title" data-edit-text="footer_heading_2" data-text-key="footer_heading_2">Liens rapides</h5>
        <ul class="list-unstyled">
          <li><a href="/#featured">Offres</a></li>
          <li><a href="/#lineup">Boutique</a></li>
          <li><a href="/#shop">Magasins</a></li>
        </ul>
      </div>
      <div class="col-md-2 col-lg-2">
        <h5 class="widget-title" data-edit-text="footer_heading_contact" data-text-key="footer_heading_contact">Contact</h5>
        <GreensFooter client:load />
      </div>
      <div class="col-lg-3">
        <h5 class="widget-title" data-edit-text="footer_heading_3" data-text-key="footer_heading_3">Abonnez-vous</h5>
        <p class="text-muted small" data-edit-text="footer_sub_text" data-text-key="footer_sub_text">Abonnez-vous à notre newsletter pour recevoir nos actualités.</p>
        <form class="d-flex mt-3" onsubmit="event.preventDefault(); this.querySelector('button').textContent='✓';">
          <input type="email" class="form-control me-2" placeholder="Adresse email" aria-label="Email">
          <button type="submit" class="btn btn-dark rounded-pill px-4" style="white-space: nowrap;">S'abonner</button>
        </form>
      </div>
    </div>
    <div class="border-top mt-4 pt-4 d-flex justify-content-between flex-wrap gap-2 text-muted small">
      <span>© {year} Driss Djellali. All Rights Reserved.</span>
      <span>Designed by Driss-Djellali</span>
    </div>
  </div>
</footer>

<CartDrawer client:load />
<ProductModal client:load />
<EditCanvas client:load />
<PulsarTexts client:load />

<script is:inline>
  (function () {
    var h = document.documentElement;
    var pre = document.getElementById('ogPreloader');
    if (pre) {
      window.addEventListener('load', function () {
        pre.classList.add('og-done');
        setTimeout(function () { pre.style.display = 'none'; }, 600);
      });
      setTimeout(function () { pre.classList.add('og-done'); setTimeout(function () { pre.style.display = 'none'; }, 600); }, 4000);
    }
    var burger = document.getElementById('ogBurger');
    var nav = document.getElementById('ogMobileNav');
    if (burger && nav) burger.addEventListener('click', function () { nav.classList.toggle('open'); });
    var themeBtn = document.getElementById('ogThemeBtn');
    if (themeBtn) {
      themeBtn.textContent = h.dataset.theme === 'dark' ? '☀️' : '🌙';
      themeBtn.addEventListener('click', function () {
        var next = h.dataset.theme === 'dark' ? 'light' : 'dark';
        h.dataset.theme = next;
        try { localStorage.setItem('greens_theme', next); } catch (e) {}
        themeBtn.textContent = next === 'dark' ? '☀️' : '🌙';
      });
    }
  })();
</script>

</body>
</html>

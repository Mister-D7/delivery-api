---
import HeaderActions from './HeaderActions';
---

<header>
  <div class="wrap header-row">
    <a href="/" class="brand brand-logo">
      <span class="brand-word">
        <span class="brand-part">PUL</span>
        <span class="brand-triangle">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <polygon class="tri-sheen" points="50,80 14,18 86,18" />
            <polygon class="tri-shape" points="50,88 8,12 92,12" />
          </svg>
        </span>
        <span class="brand-part">SAR</span>
      </span>
      <span class="brand-sub">Designed by DjDr</span>
    </a>
    <div class="header-right">
      <button id="themeToggle" class="theme-toggle" type="button" aria-label="Changer de thème (sombre / clair)" title="Changer de thème">
        <span class="t-sun" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 1.5v3M12 19.5v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1.5 12h3M19.5 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
          </svg>
        </span>
        <span class="t-moon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </span>
      </button>
      <HeaderActions client:load />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('header');
    if (!header) return;
    var lastY = window.scrollY;
    var ticking = false;
    var hideAfter = 140;
    var nearTop = 8;
    function update() {
      var y = window.scrollY;
      if (y > lastY && y > hideAfter) {
        header.classList.add('hdr-hidden');
      } else if (y <= nearTop) {
        header.classList.remove('hdr-hidden');
      }
      lastY = y;
      ticking = false;
    }
    if (window.scrollY > hideAfter) {
      header.classList.add('hdr-hidden');
    }
    window.addEventListener('scroll', function () {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('pulsar_theme', next); } catch (e) {}
      window.dispatchEvent(new CustomEvent('theme:change', { detail: { theme: next } }));
    });
  })();
</script>

<script is:inline>
  (function () {
    var form = document.getElementById('gamingSearch');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var input = form.querySelector('input');
        var q = input ? input.value.trim() : '';
        window.dispatchEvent(new CustomEvent('storefront:search', { detail: { q: q } }));
        var el = document.getElementById('products');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      });
    }

    var wraps = document.querySelectorAll('.mega-wrap');

    function setMega(wrap, open) {
      var btn = wrap.querySelector('.g-nav-drop');
      var panel = wrap.querySelector('.mega-panel');
      wrap.classList.toggle('mega-open', open);
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (panel) panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    function closeAllMega() {
      wraps.forEach(function (w) {
        setMega(w, false);
      });
    }

    wraps.forEach(function (wrap) {
      var btn = wrap.querySelector('.g-nav-drop');
      if (btn) {
        btn.addEventListener('click', function () {
          var isOpen = wrap.classList.contains('mega-open');
          closeAllMega();
          if (!isOpen) setMega(wrap, true);
        });
      }
    });

    document.addEventListener('click', function (e) {
      var inside = Array.prototype.some.call(wraps, function (w) {
        return w.contains(e.target);
      });
      if (!inside) closeAllMega();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAllMega();
    });

    function fireFilter(el) {
      var cat = el.getAttribute('data-cat');
      if (cat) {
        window.dispatchEvent(new CustomEvent('category:filter', { detail: { name: cat } }));
      }
      var brand = el.getAttribute('data-brand');
      if (brand) {
        window.dispatchEvent(new CustomEvent('brand:filter', { detail: { brand: brand } }));
      }
      closeAllMega();
      var el2 = document.getElementById('products');
      if (el2) el2.scrollIntoView({ behavior: 'smooth' });
    }

    document.querySelectorAll('.mega-link').forEach(function (l) {
      l.addEventListener('click', function () {
        fireFilter(l);
      });
    });
  })();
</script>
